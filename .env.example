# DeepSeek is OpenAI-compatible. Fill this first if you want the cheaper DeepSeek path.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
MAX_PAPER_CHARS=20000
LLM_MAX_TOKENS=3000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=60000
LLM_TEST_TIMEOUT_MS=20000

# arXiv source download: timeout per endpoint and fallback source endpoints
ARXIV_TIMEOUT_MS=60000
# LaTeX tables are rendered first; set this to false only to force PDF cropping.
ENABLE_LATEX_TABLE_RENDER=true
AGENT_MAX_TASK_ROUNDS=6
AGENT_TASK_EVIDENCE_CHARS=6500
AGENT_TASK_EVIDENCE_CHUNKS=5
ARXIV_SOURCE_BASE_URLS=https://arxiv.org/e-print,https://export.arxiv.org/e-print

# Paper-reading Agent pipeline
AGENT_CONTEXT_CHARS=26000
AGENT_TASK_CONTEXT_CHARS=6500
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
AGENT_ANALYSIS_TOKENS=3200
AGENT_VERIFY_TOKENS=1400
AGENT_ANALYSIS_TIMEOUT_MS=70000
AGENT_VERIFY_TIMEOUT_MS=50000
AGENT_VERIFY=true

# Visual poster reviewer (Alibaba Cloud Model Studio / DashScope)
# Create a separate key at https://bailian.console.aliyun.com/ and keep DeepSeek for text analysis.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max
VISION_MAX_TOKENS=2200
VISION_TIMEOUT_MS=90000
POSTER_REFINE_MAX_TOKENS=1800
POSTER_REFINE_TIMEOUT_MS=60000

# Optional OpenAI fallback:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
